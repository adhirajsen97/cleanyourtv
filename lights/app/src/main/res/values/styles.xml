<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HomeLights" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!-- A wide switch button for the remote: the focused one lights up warm, the last one pressed keeps a thin ring. -->
    <style name="SwitchButton">
        <item name="android:layout_width">180dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:textColor">@drawable/button_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
