<?xml version="1.0" encoding="utf-8"?>
<!-- Continue watching tile progress: a dark track that reads on bright artwork, and a fill that the
     view's level (0 to 10000) clips. LastPlayedAdapter tints the fill while that app is playing. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#73000000" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip
            android:clipOrientation="horizontal"
            android:gravity="left">
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="#F2FFFFFF" />
            </shape>
        </clip>
    </item>
</layer-list>
